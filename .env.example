# Configurações do Sistema de Assessoria Nutricional (UNCISAL)
# Copie este arquivo para .env e preencha com suas credenciais seguras

# Chave secreta de sessão Flask (Gere uma chave aleatória forte em produção)
SECRET_KEY=chave_secreta_assessoria_nutricional_uncisal_2026_jwt_token_secure

# Credenciais de acesso do Nutricionista
ADMIN_USER=nutri
ADMIN_PASSWORD=nutri2026

# Chave de API da Groq Cloud (https://console.groq.com/)
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Porta de execução do servidor
PORT=5000
